{
  "version": 2,
  "source": {
    "file": "Primitives.json",
    "include": ["color/brand/*", "color/zinc/*"]
  },
  "theme": {
    "selector": ":root:not(.dark)",
    "mode": "light"
  },
  "coss": {
    "foreground": {
      "token": "color/zinc/800"
    },
    "card-foreground": {
      "token": "color/zinc/800"
    },
    "popover-foreground": {
      "token": "color/zinc/800"
    },
    "primary": {
      "token": "color/brand/800-base"
    },
    "primary-foreground": {
      "css": "var(--color-white)",
      "reason": "COSS white reaches 4.52:1 on brand/800-base; zinc/50 reaches only 4.32:1."
    },
    "secondary-foreground": {
      "token": "color/zinc/800"
    },
    "muted-foreground": {
      "token": "color/zinc/600",
      "reason": "Zinc/600 remains readable on COSS's low-alpha muted surfaces."
    },
    "accent-foreground": {
      "token": "color/zinc/800"
    },
    "ring": {
      "token": "color/brand/500"
    },
    "sidebar": {
      "token": "color/zinc/100"
    },
    "sidebar-foreground": {
      "token": "color/zinc/700"
    },
    "sidebar-primary": {
      "token": "color/brand/800-base"
    },
    "sidebar-primary-foreground": {
      "css": "var(--color-white)"
    },
    "sidebar-accent": {
      "css": "var(--color-white)"
    },
    "sidebar-accent-foreground": {
      "token": "color/zinc/900"
    },
    "sidebar-border": {
      "css": "--alpha(var(--color-black) / 8%)",
      "reason": "A quiet neutral divider keeps the light navigation shell behind the white workspace."
    },
    "sidebar-ring": {
      "token": "color/brand/500"
    }
  }
}
